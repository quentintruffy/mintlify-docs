{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Mint Starter Kit",
  "search": {
    "prompt": "Search..."
  },
  "colors": {
    "primary": "#00A7F9",
    "light": "#32CCFF",
    "dark": "#00A7F9"
  },
  "background": {
    "image": "/public/background.png"
  },
  "favicon": "public/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Knowledge",
        "groups": [
          {
            "group": "Essentials",
            "root": "/knowledge",
            "pages": ["knowledge"]
          }
        ]
      },
      {
        "tab": "Calendar Top",
        "groups": [
          {
            "group": "Essentials",
            "root": "/calendar",
            "pages": [
              {
                "group": "Introduction",
                "root": "/mona",
                "pages": [
                  "calendar/introduction",
                  "calendar/connexion",
                  "calendar/calendar"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Nomad Top",
        "groups": [
          {
            "group": "Essentials",
            "root": "/nomad",
            "pages": [
              {
                "group": "Introduction",
                "root": "/nomad",
                "pages": ["nomad/introduction", "nomad/api"]
              }
            ]
          }
        ]
      },
      {
        "tab": "Mona Guides",
        "groups": [
          {
            "group": "Writing Content",
            "pages": [
              {
                "group": "Introduction",
                "root": "/mona",
                "pages": ["mona/introduction"]
              }
            ]
          }
        ]
      },
      {
        "tab": "Mona API",
        "groups": [
          {
            "group": "Writing Content",
            "pages": [
              {
                "group": "API",
                "root": "/mona",
                "pages": ["mona/api"]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Site officiel",
          "icon": "earth-europe",
          "href": "https://www.nomadia-group.com/"
        }
      ],
      "languages": [
        {
          "default": true,
          "language": "fr",
          "href": "https://fr.mintlify.com"
        },
        {
          "default": false,
          "language": "en",
          "href": "https://fr.mintlify.com"
        }
      ],
      "dropdowns": [
        {
          "dropdown": "Getting Started",
          "description": "Set up your project",
          "icon": "book-open",
          "href": "http://localhost:3000/"
        },
        {
          "dropdown": "API Integration",
          "description": "Set uo your project",
          "icon": "plug",
          "href": "https://www.nomadia-group.com/"
        },
        {
          "dropdown": "Changelog",
          "description": "Update and changes",
          "icon": "list-check",
          "href": "https://www.nomadia-group.com/"
        }
      ]
    }
  },
  "logo": {
    "light": "/public/assets/dark-logo.svg",
    "dark": "/public/assets/light-logo.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/NomadiaGroup",
      "youtube": "https://www.youtube.com/c/NOMADIA-GROUP",
      "facebook": "https://www.facebook.com/Nomadia.group",
      "linkedin": "https://www.linkedin.com/company/nomadia-group/"
    }
  }
}
